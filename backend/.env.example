PORT=5000
MONGO_URI=mongodb://localhost:27017/cloudpilot
JWT_SECRET=your_jwt_secret_key_here

# Cloudflare R2 Credentials (Private S3 compatible)
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="CloudPilot Mission Control <no-reply@cloudpilot.io>"

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# GitHub OAuth App (used for repo connection & Code Analysis Agent file access)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

# RunPod-hosted qwen3:14b model (OpenAI-compatible chat completions endpoint)
# e.g. https://api.runpod.ai/v2/<endpoint_id>/openai/v1
RUNPOD_BASE_URL=
RUNPOD_API_KEY=
RUNPOD_MODEL=qwen3:14b
# Embedding model served on the same RunPod endpoint (OpenAI-compatible /embeddings route)
RUNPOD_EMBED_MODEL=nomic-embed-text

# Chroma vector DB (run via `docker compose up -d chroma` at the repo root)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=cloudpilot-knowledge-base

